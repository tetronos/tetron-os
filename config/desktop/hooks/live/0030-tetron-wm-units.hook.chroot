#!/bin/sh
# The full screen video helper owns tty9 for the live user; tetronos-firstboot
# enables it for the user an install creates. Live ISO only, so it stays a
# hook. The rest of what makes the Desktop (ssh off, the app server unit,
# opencode) is done by tetronos-desktop-config, which a Server upgraded with
# apt install tetronos-desktop gets too.
set -e
systemctl enable tetron-wm-fullscreen@tetronos.service
