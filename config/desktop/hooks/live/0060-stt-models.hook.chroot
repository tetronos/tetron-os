#!/bin/sh
# tetron-stt (speech to text) works offline on the Desktop image: its two models
# (about 0.96 GB, sha256 checked by tetron-stt itself) are fetched at build time
# into /usr/share/tetron-stt/models, which tetron-stt reads before the per-user
# directory. A system upgraded with apt install tetronos-desktop has no models
# and downloads them on first use (tetron-stt models download). The build fails
# when a model can not be fetched or verified.
set -e
d=/usr/share/tetron-stt/models
install -d -m 755 "$d"
TETRON_STT_MODELS="$d" tetron-stt models download
TETRON_STT_MODELS="$d" tetron-stt models status --json | grep -q '"installed":true' ||
	{ echo "tetron-stt: models are not all installed in $d" >&2; exit 1; }
rm -rf "$d/.download"
cat > "$d/NOTICE.txt" <<'EOF'
These speech models are NVIDIA's, converted to ONNX by the sherpa-onnx project
(https://k2-fsa.github.io/sherpa/onnx/), licensed CC-BY-4.0:
  Nemotron 3.5 ASR streaming 0.6B  https://huggingface.co/nvidia/nemotron-3.5-asr-streaming-0.6b
  Parakeet TDT 0.6B v2             https://huggingface.co/nvidia/parakeet-tdt-0.6b-v2
Fetched by tetron-stt (https://github.com/tetronos/tetron-stt) when the image was built.
EOF
echo "tetron-stt models in $d"
