#!/bin/sh
# udisksd asks polkit for the authority once, at start: installed in the same apt run as polkitd,
# it started first and refuses every user ("polkit authority not available") until restarted.
set -e
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	systemctl try-restart udisks2.service >/dev/null 2>&1 || true
fi
