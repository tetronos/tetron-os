#!/bin/sh
# Live ISO: allow SSH password login only once no account has the public
# live password "live". The drop-in is read before the main sshd_config,
# so it wins over live-config's PasswordAuthentication no.
conf=/etc/ssh/sshd_config.d/40-tetronos-live-password.conf
if perl -e '
	open(my $f, "<", "/etc/shadow") or exit 0;
	while (<$f>) {
		my $h = (split /:/)[1];
		next if !defined $h || length($h) < 2 || $h =~ /^[!*]/;
		exit 0 if crypt("live", $h) eq $h;
	}
	exit 1;'; then
	v=no
	echo "an account still has the live password; ssh password login stays off (run passwd to enable it)"
else
	v=yes
	echo "no account has the live password; ssh password login is on"
fi
mkdir -p "${conf%/*}"
printf '# Written by /usr/libexec/tetronos/live-ssh-password\nPasswordAuthentication %s\nKbdInteractiveAuthentication %s\n' "$v" "$v" > "$conf"
if [ "${1:-}" = --reload ] && systemctl -q is-active ssh.service; then
	systemctl reload ssh.service
fi
exit 0
