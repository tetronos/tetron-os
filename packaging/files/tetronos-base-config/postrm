#!/bin/sh
# Remove the /etc/skel folders, but only when they are still empty.
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
	for d in Desktop Documents Downloads Pictures code; do
		rmdir "/etc/skel/$d" 2>/dev/null || true
	done
	systemctl disable tetronos-ssh-temp-cleanup.service >/dev/null 2>&1 || true
	[ "$(readlink /etc/systemd/system/default.target 2>/dev/null)" = /usr/lib/systemd/system/multi-user.target ] && rm -f /etc/systemd/system/default.target || true
fi
