#!/bin/sh
# tetronos-ssh-temp: temporary ssh access with a username and a password you enter, until reboot.
#
#   tetronos-ssh-temp on       ask for a username and a password, start sshd, show how to connect
#   tetronos-ssh-temp off      end it: remove the login, restore what was there before
#   tetronos-ssh-temp status [--json]
#   tetronos-ssh-temp cleanup  end a leftover one after a reboot (run at boot by a systemd unit)
#
# The password is typed at the passwd prompt in the terminal, never on a command line. Only that
# one account may log in with a password (a "Match User" block in an sshd drop-in), other accounts
# and their keys are not touched. A name that does not exist is created as a plain account (no
# sudo) and removed again by "off", its home folder is kept. An existing normal account keeps its
# own password: the old hash is saved and put back by "off". Nothing is enabled at boot, so a reboot
# ends it; the cleanup at boot removes what a crash or a power cut left behind.
set -u

STATE_DIR=/var/lib/tetronos/ssh-temp
STATE=$STATE_DIR/state          # root only: the saved old password hash is in it
PUB=/run/tetronos/ssh-temp.status  # world readable, for status and the tetron-wm Settings row
DROPIN=/etc/ssh/sshd_config.d/39-tetronos-ssh-temp.conf

die() { echo "tetronos-ssh-temp: $*" >&2; exit 1; }
say() { [ "${QUIET:-0}" = 1 ] || echo "$@"; }
need_root() { [ "$(id -u)" = 0 ] || exec sudo -- "$0" "$@"; }

# Shell quoting for the state file: 'it''s' -> 'it'\''s'
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

write_pub() {
	mkdir -p /run/tetronos
	chmod 0755 /run/tetronos
	printf 'user=%s\nsince=%s\n' "$1" "$(date +%s)" > "$PUB"
	chmod 0644 "$PUB"
}

save_state() { # user created oldhash was_active was_enabled
	mkdir -p "$STATE_DIR"; chmod 0700 "$STATE_DIR"
	# A subshell: the umask must not leak into the rest (the status file and the drop-in are
	# world readable, the state file holds the saved old password hash and is root only).
	(
		umask 077
		{
			printf 'user=%s\n' "$(q "$1")"
			printf 'created=%s\n' "$2"
			printf 'oldhash=%s\n' "$(q "$3")"
			printf 'was_active=%s\n' "$4"
			printf 'was_enabled=%s\n' "$5"
		} > "$STATE"
	)
}

cmd_status() {
	if [ -r "$PUB" ]; then
		# shellcheck disable=SC1090
		. "$PUB"
		if [ "${1:-}" = --json ]; then printf '{"on":true,"user":"%s","since":%s}\n' "$user" "$since"
		else echo "on: user $user"; fi
	else
		if [ "${1:-}" = --json ]; then echo '{"on":false}'; else echo "off"; fi
	fi
}

connect_info() {
	user="$1"
	echo
	echo "Remote access is ON until the next reboot (or: sudo tetronos-ssh-temp off)."
	echo "From another computer on the same network:"
	ips=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
	if [ -n "$ips" ]; then for ip in $ips; do echo "    ssh $user@$ip"; done
	else echo "    ssh $user@<this computer's address>   (no network address found)"; fi
	echo "Only $user can log in with a password. sshd listens on all networks while this is on."
}

cmd_on() {
	need_root on "$@"
	if [ -e "$STATE" ]; then echo "Remote access is already on."; cmd_status; return 0; fi
	[ -x /usr/sbin/sshd ] || die "openssh-server is not installed (sudo apt install openssh-server)"
	printf 'Username for the remote login [remote]: '
	read -r user || die "no input"
	user=${user:-remote}
	case $user in
		''|[!a-z_]*|*[!a-z0-9_-]*) die "a username is lowercase letters, digits, - and _, starting with a letter" ;;
	esac
	[ "${#user}" -le 32 ] || die "that username is too long"
	created=0; oldhash=
	if id "$user" >/dev/null 2>&1; then
		uid=$(id -u "$user")
		{ [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]; } || die "$user is a system account; pick another name"
		oldhash=$(getent shadow "$user" | cut -d: -f2)
		echo "$user exists: its password changes now and is put back when this ends."
	else
		created=1
	fi
	was_active=0; was_enabled=0
	systemctl is-active --quiet ssh.service && was_active=1
	systemctl is-enabled --quiet ssh.service 2>/dev/null && was_enabled=1
	# State first, so an interrupted run can still be cleaned up.
	save_state "$user" "$created" "$oldhash" "$was_active" "$was_enabled"
	if [ "$created" = 1 ]; then
		useradd -m -s /bin/bash -c "TetronOS temporary remote login" "$user" || { rm -f "$STATE"; die "could not create $user"; }
	fi
	echo "Type the password for $user (twice). It is not shown and not stored anywhere else."
	if ! passwd "$user"; then
		QUIET=1 cmd_off_inner
		die "the password was not set; remote access stays off"
	fi
	mkdir -p "${DROPIN%/*}"
	cat > "$DROPIN" <<CONF
# Written by tetronos-ssh-temp. Removed by "tetronos-ssh-temp off" and at boot.
Match User $user
    PasswordAuthentication yes
    AuthenticationMethods password
    MaxAuthTries 3
CONF
	chmod 0644 "$DROPIN"
	# sshd -t needs /run/sshd, which ssh.service only creates when it starts.
	mkdir -p /run/sshd && chmod 0755 /run/sshd
	if ! /usr/sbin/sshd -t 2>/tmp/ssh-temp.err; then
		cat /tmp/ssh-temp.err >&2; rm -f /tmp/ssh-temp.err
		QUIET=1 cmd_off_inner
		die "sshd rejected the configuration; remote access stays off"
	fi
	rm -f /tmp/ssh-temp.err
	if [ "$was_active" = 1 ]; then systemctl reload ssh.service; else systemctl start ssh.service || { QUIET=1 cmd_off_inner; die "sshd did not start"; }; fi
	write_pub "$user"
	connect_info "$user"
}

# The end of it, without asking for root again (used by "off", "cleanup" and failed "on").
cmd_off_inner() {
	[ -e "$STATE" ] || return 0
	user=; created=0; oldhash=; was_active=0; was_enabled=0
	# shellcheck disable=SC1090
	. "$STATE"
	rm -f "$DROPIN"
	if [ "$was_active" = 1 ]; then systemctl reload ssh.service 2>/dev/null || true
	else systemctl stop ssh.service 2>/dev/null || true; fi
	if [ -n "$user" ]; then
		if [ "$created" = 1 ]; then
			# Our own throwaway account: end everything it runs, then remove it.
			loginctl terminate-user "$user" 2>/dev/null || true
			pkill -KILL -u "$user" 2>/dev/null || true
			userdel -f "$user" 2>/dev/null && say "The account $user is removed; its home folder /home/$user is kept."
		else
			# An existing account (maybe the one running this command): only its ssh sessions end,
			# never its local ones.
			pkill -KILL -f "^sshd-session: $user[@ ]" 2>/dev/null || true
			if [ -n "$oldhash" ]; then
				usermod -p "$oldhash" "$user" && say "The old password of $user is back."
			fi
		fi
	fi
	rm -f "$STATE" "$PUB"
}

cmd_off() {
	need_root off "$@"
	if [ ! -e "$STATE" ]; then say "Remote access is off."; return 0; fi
	cmd_off_inner
	say "Remote access is OFF."
}

case "${1:-}" in
	on) shift; cmd_on "$@" ;;
	off) shift; cmd_off "$@" ;;
	status) shift; cmd_status "$@" ;;
	cleanup) need_root cleanup; QUIET=1 cmd_off_inner ;;
	*) echo "usage: tetronos-ssh-temp on|off|status [--json]|cleanup" >&2; exit 2 ;;
esac
