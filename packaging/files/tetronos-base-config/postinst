#!/bin/sh
# Folders every new home directory gets: the ones the tetron-wm Files app expects, and code (the AI and code folder, ~/code).
set -e
if [ "$1" = configure ]; then
	for d in Desktop Documents Downloads Pictures code; do
		mkdir -p "/etc/skel/$d"
		chmod 0755 "/etc/skel/$d"
	done
	# Ends a temporary ssh login (tetronos-ssh-temp) that a reboot or a crash left behind.
	systemctl enable tetronos-ssh-temp-cleanup.service >/dev/null 2>&1 || true
fi
