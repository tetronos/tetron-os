diff --git a/src/input/input_internal.h b/src/input/input_internal.h
index 383754e..c3f652a 100644
--- a/src/input/input_internal.h
+++ b/src/input/input_internal.h
@@ -81,6 +81,21 @@ struct input_pointer {
 
 	/* Track which button is currently pressed (BUTTON_NONE=none, 0=left, 1=right, 2=middle) */
 	uint8_t pressed_button;
+
+	/* Touchpad tap-to-click (--touchpad-tap). A tap is a touch that is short, does not move and
+	 * has no physical button press; the most fingers seen during the touch pick the button:
+	 * one finger left, two right, three middle. */
+	uint8_t tool_mask;       /* BTN_TOOL_FINGER/DOUBLETAP/TRIPLETAP currently down: bits 0..2 */
+	bool tap_active;         /* a touch that may still become a tap */
+	bool tap_moved;          /* it moved too far */
+	bool tap_button;         /* a physical button was pressed during it */
+	bool tap_synth;          /* we are sending the click of a tap ourselves */
+	bool tap_have_x;         /* tap_start_x holds the first X of the touch */
+	bool tap_have_y;
+	uint8_t tap_fingers;     /* the most fingers seen during the touch (1..3) */
+	struct timespec tap_down;
+	int32_t tap_start_x;
+	int32_t tap_start_y;
 };
 
 struct input_dev {
@@ -127,6 +142,8 @@ struct input {
 	struct xkb_compose_table *compose_table;
 
 	bool mouse_enabled;
+	/* Touchpad tap-to-click, off by default (like libinput's default) */
+	bool touchpad_tap;
 	struct shl_hook *pointer_hook;
 	int32_t pointer_max_x;
 	int32_t pointer_max_y;
diff --git a/src/input/input_pointer.c b/src/input/input_pointer.c
index ec55494..08bec26 100644
--- a/src/input/input_pointer.c
+++ b/src/input/input_pointer.c
@@ -1,11 +1,58 @@
 #include <linux/input-event-codes.h>
 #include <linux/input.h>
+#include <stdlib.h>
 #include <time.h>
 #include "input.h"
 #include "input_internal.h"
 #include "shl/eloop.h"
 #include "shl/hook.h"
 
+/* A tap is a touch that is shorter than this, in ms (libinput uses 180). */
+#define TAP_TIMEOUT_MS 200
+/* ... and that moves less than this share of the touchpad axis range: 1 / TAP_MOVE_DIV. */
+#define TAP_MOVE_DIV 40
+
+static uint64_t pointer_ms_since(const struct timespec *from, const struct timespec *to)
+{
+	return (uint64_t)(to->tv_sec - from->tv_sec) * 1000 +
+	       (uint64_t)((to->tv_nsec - from->tv_nsec) / 1000000);
+}
+
+/* How many fingers are down now, from the BTN_TOOL_* state: 0 to 3. */
+static uint8_t pointer_tool_fingers(const struct input_dev *dev)
+{
+	if (dev->pointer.tool_mask & 4)
+		return 3;
+	if (dev->pointer.tool_mask & 2)
+		return 2;
+	if (dev->pointer.tool_mask & 1)
+		return 1;
+	return 0;
+}
+
+static bool pointer_tap_enabled(const struct input_dev *dev)
+{
+	return dev->input->touchpad_tap && dev->pointer.kind == POINTER_TOUCHPAD;
+}
+
+/* Track how far a touch that may become a tap has moved, from the raw ABS value. */
+static void pointer_tap_track(struct input_dev *dev, int32_t value, bool is_x)
+{
+	struct input_pointer *ptr = &dev->pointer;
+	int32_t range = is_x ? ptr->max_x - ptr->min_x : ptr->max_y - ptr->min_y;
+	int32_t limit = range > 0 ? range / TAP_MOVE_DIV : 50;
+	bool *have = is_x ? &ptr->tap_have_x : &ptr->tap_have_y;
+	int32_t *start = is_x ? &ptr->tap_start_x : &ptr->tap_start_y;
+
+	if (!*have) {
+		*have = true;
+		*start = value;
+		return;
+	}
+	if (abs(value - *start) > limit)
+		ptr->tap_moved = true;
+}
+
 static void pointer_update_inactivity_timer(struct input_dev *dev)
 {
 	struct itimerspec spec;
@@ -101,6 +148,8 @@ static void pointer_dev_abs_x(struct input_dev *dev, int32_t value)
 {
 	switch (dev->pointer.kind) {
 	case POINTER_TOUCHPAD:
+		if (dev->pointer.tap_active)
+			pointer_tap_track(dev, value, true);
 		if (dev->pointer.touchpad_needs_sync_off_x) {
 			dev->pointer.off_x = dev->pointer.x - value;
 			dev->pointer.touchpad_needs_sync_off_x = false;
@@ -133,6 +182,8 @@ static void pointer_dev_abs_y(struct input_dev *dev, int32_t value)
 {
 	switch (dev->pointer.kind) {
 	case POINTER_TOUCHPAD:
+		if (dev->pointer.tap_active)
+			pointer_tap_track(dev, value, false);
 		if (dev->pointer.touchpad_needs_sync_off_y) {
 			dev->pointer.off_y = dev->pointer.y - value;
 			dev->pointer.touchpad_needs_sync_off_y = false;
@@ -173,6 +224,22 @@ void pointer_dev_abs(struct input_dev *dev, uint16_t code, int32_t value)
 	}
 }
 
+/* The click of a tap: one finger left, two right, three middle. */
+static void pointer_tap_click(struct input_dev *dev)
+{
+	uint16_t code = BTN_LEFT;
+
+	if (dev->pointer.tap_fingers >= 3)
+		code = BTN_MIDDLE;
+	else if (dev->pointer.tap_fingers == 2)
+		code = BTN_RIGHT;
+
+	dev->pointer.tap_synth = true;
+	pointer_dev_button(dev, code, 1);
+	pointer_dev_button(dev, code, 0);
+	dev->pointer.tap_synth = false;
+}
+
 void pointer_dev_button(struct input_dev *dev, uint16_t code, int32_t value)
 {
 	struct timespec tp;
@@ -184,6 +251,26 @@ void pointer_dev_button(struct input_dev *dev, uint16_t code, int32_t value)
 	if (value > 1)
 		return;
 
+	/* Finger count of the touch, from the BTN_TOOL_* state. With --touchpad-tap the two and
+	 * three finger states are not a middle button press any more: they pick the tap's button. */
+	if (code == BTN_TOOL_FINGER ||
+	    (pointer_tap_enabled(dev) && (code == BTN_TOOL_DOUBLETAP || code == BTN_TOOL_TRIPLETAP))) {
+		uint8_t bit = code == BTN_TOOL_FINGER ? 1 : (code == BTN_TOOL_DOUBLETAP ? 2 : 4);
+
+		if (pressed)
+			dev->pointer.tool_mask |= bit;
+		else
+			dev->pointer.tool_mask &= ~bit;
+		if (dev->pointer.tap_active && pointer_tool_fingers(dev) > dev->pointer.tap_fingers)
+			dev->pointer.tap_fingers = pointer_tool_fingers(dev);
+		return;
+	}
+
+	/* A physical button press during a touch: it is a click, not a tap. */
+	if (pressed && !dev->pointer.tap_synth &&
+	    (code == BTN_LEFT || code == BTN_RIGHT || code == BTN_MIDDLE))
+		dev->pointer.tap_button = true;
+
 	switch (code) {
 	case BTN_LEFT:
 		if (pressed) {
@@ -214,6 +301,26 @@ void pointer_dev_button(struct input_dev *dev, uint16_t code, int32_t value)
 			dev->pointer.touchpad_needs_sync_off_x = true;
 			dev->pointer.touchpad_needs_sync_off_y = true;
 		}
+		if (pointer_tap_enabled(dev)) {
+			if (pressed) {
+				uint8_t fingers = pointer_tool_fingers(dev);
+
+				dev->pointer.tap_active = true;
+				dev->pointer.tap_moved = false;
+				dev->pointer.tap_button = false;
+				dev->pointer.tap_have_x = false;
+				dev->pointer.tap_have_y = false;
+				dev->pointer.tap_fingers = fingers ? fingers : 1;
+				clock_gettime(CLOCK_MONOTONIC, &dev->pointer.tap_down);
+			} else if (dev->pointer.tap_active) {
+				dev->pointer.tap_active = false;
+				clock_gettime(CLOCK_MONOTONIC, &tp);
+				elapsed = pointer_ms_since(&dev->pointer.tap_down, &tp);
+				if (!dev->pointer.tap_moved && !dev->pointer.tap_button &&
+				    elapsed < TAP_TIMEOUT_MS)
+					pointer_tap_click(dev);
+			}
+		}
 		break;
 	default:
 		break;
diff --git a/src/seat.c b/src/seat.c
index a64c472..342caf5 100644
--- a/src/seat.c
+++ b/src/seat.c
@@ -743,6 +743,7 @@ int kmscon_seat_new(struct kmscon_seat **out, struct conf_ctx *main_conf,
 
 	input_set_conf(seat->input, seat->conf->xkb_repeat_delay, seat->conf->xkb_repeat_rate,
