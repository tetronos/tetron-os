diff --git a/tests/meson.build b/tests/meson.build
index 9edcb70..5df7275 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -76,3 +76,12 @@ test_issue_parameter = executable(
     dependencies: [libtsm_deps, shl_deps],
 )
 test('test_issue_parameter', test_issue_parameter)
+
+# Touchpad tap-to-click: the pointer code is compiled into the test, no device or display needed.
+test_touchpad_tap = executable(
+    'test_touchpad_tap',
+    ['test_touchpad_tap.c', '../src/input/input_pointer.c'],
+    dependencies: [shl_deps, eloop_deps],
+    include_directories: include_directories('../src', '../src/input'),
+)
+test('test_touchpad_tap', test_touchpad_tap)
diff --git a/tests/test_touchpad_tap.c b/tests/test_touchpad_tap.c
new file mode 100644
index 0000000..1a47b26
--- /dev/null
+++ b/tests/test_touchpad_tap.c
@@ -0,0 +1,203 @@
+/*
+ * test_touchpad_tap - touchpad tap-to-click (--touchpad-tap)
+ *
+ * Feeds synthetic touchpad events (the evdev ones a real touchpad sends) through the pointer
+ * code of kmscon and checks the button reports that come out. input_pointer.c is compiled into
+ * this program, so no device, no VT and no display is needed.
+ */
+#include <assert.h>
+#include <linux/input-event-codes.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include "input.h"
+#include "input_internal.h"
+#include "shl/hook.h"
+
+struct log {
+	int presses[3]; /* left (0), middle (1), right (2) */
+	int releases[3];
+	int dbl;
+};
+
+static void on_pointer(struct input *input, struct input_pointer_event *ev, void *data)
+{
+	struct log *l = data;
+
+	(void)input;
+	if (ev->event != POINTER_BUTTON || ev->button > 2)
+		return;
+	if (ev->pressed)
+		l->presses[ev->button]++;
+	else
+		l->releases[ev->button]++;
+	if (ev->double_click)
+		l->dbl++;
+}
+
+static struct input inp;
+static struct input_dev dev;
+static struct log lg;
+
+static void setup(bool tap)
+{
+	memset(&inp, 0, sizeof(inp));
+	memset(&dev, 0, sizeof(dev));
+	memset(&lg, 0, sizeof(lg));
+	assert(shl_hook_new(&inp.pointer_hook) == 0);
+	assert(shl_hook_add_cast(inp.pointer_hook, on_pointer, &lg, false) == 0);
+	inp.pointer_max_x = 1000;
+	inp.pointer_max_y = 1000;
+	inp.touchpad_tap = tap;
+	dev.input = &inp;
+	dev.pointer.kind = POINTER_TOUCHPAD;
+	dev.pointer.pressed_button = BUTTON_NONE;
+	dev.pointer.min_x = 0;
+	dev.pointer.max_x = 4000;
+	dev.pointer.min_y = 0;
+	dev.pointer.max_y = 2000;
+}
+
+static void teardown(void)
+{
+	shl_hook_free(inp.pointer_hook);
+}
+
+static void touch_down(int x, int y, int fingers)
+{
+	/* The order a touchpad driver sends: BTN_TOUCH, the tool state, then the position. */
+	pointer_dev_button(&dev, BTN_TOUCH, 1);
+	if (fingers >= 1)
+		pointer_dev_button(&dev, BTN_TOOL_FINGER, fingers == 1);
+	if (fingers == 2)
+		pointer_dev_button(&dev, BTN_TOOL_DOUBLETAP, 1);
+	if (fingers == 3)
+		pointer_dev_button(&dev, BTN_TOOL_TRIPLETAP, 1);
+	pointer_dev_abs(&dev, ABS_X, x);
+	pointer_dev_abs(&dev, ABS_Y, y);
+}
+
+static void touch_up(int fingers)
+{
+	if (fingers == 3)
+		pointer_dev_button(&dev, BTN_TOOL_TRIPLETAP, 0);
+	if (fingers == 2)
+		pointer_dev_button(&dev, BTN_TOOL_DOUBLETAP, 0);
+	pointer_dev_button(&dev, BTN_TOOL_FINGER, 0);
+	pointer_dev_button(&dev, BTN_TOUCH, 0);
+}
+
+static void sleep_ms(long ms)
+{
+	struct timespec ts = {.tv_sec = ms / 1000, .tv_nsec = (ms % 1000) * 1000000L};
+
+	nanosleep(&ts, NULL);
+}
+
+static int total(const int *a)
+{
+	return a[0] + a[1] + a[2];
+}
+
+int main(void)
+{
+	/* One finger tap: a left click. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	touch_up(1);
+	assert(lg.presses[0] == 1 && lg.releases[0] == 1);
+	assert(total(lg.presses) == 1);
+	teardown();
+
+	/* Two finger tap: right click (button 2); three finger tap: middle click (button 1). */
+	setup(true);
+	touch_down(1000, 500, 2);
+	touch_up(2);
+	assert(lg.presses[2] == 1 && lg.releases[2] == 1 && total(lg.presses) == 1);
+	teardown();
+	setup(true);
+	touch_down(1000, 500, 3);
+	touch_up(3);
+	assert(lg.presses[1] == 1 && lg.releases[1] == 1 && total(lg.presses) == 1);
+	teardown();
+
+	/* The tool state may arrive before BTN_TOUCH (some drivers): still a two finger tap. */
+	setup(true);
+	pointer_dev_button(&dev, BTN_TOOL_FINGER, 1);
+	pointer_dev_button(&dev, BTN_TOOL_DOUBLETAP, 1);
+	pointer_dev_button(&dev, BTN_TOUCH, 1);
+	pointer_dev_abs(&dev, ABS_X, 1000);
+	pointer_dev_abs(&dev, ABS_Y, 500);
+	pointer_dev_button(&dev, BTN_TOOL_DOUBLETAP, 0);
+	pointer_dev_button(&dev, BTN_TOOL_FINGER, 0);
+	pointer_dev_button(&dev, BTN_TOUCH, 0);
+	assert(lg.presses[2] == 1 && total(lg.presses) == 1);
+	teardown();
+
+	/* A slide is not a tap. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	pointer_dev_abs(&dev, ABS_X, 1400);
+	pointer_dev_abs(&dev, ABS_Y, 700);
+	touch_up(1);
+	assert(total(lg.presses) == 0);
+	teardown();
+
+	/* A small wobble is still a tap. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	pointer_dev_abs(&dev, ABS_X, 1030);
+	pointer_dev_abs(&dev, ABS_Y, 510);
+	touch_up(1);
+	assert(lg.presses[0] == 1);
+	teardown();
+
+	/* A long touch is not a tap. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	sleep_ms(400);
+	touch_up(1);
+	assert(total(lg.presses) == 0);
+	teardown();
+
+	/* Pressing the physical button during the touch is a click, not also a tap. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	pointer_dev_button(&dev, BTN_LEFT, 1);
+	pointer_dev_button(&dev, BTN_LEFT, 0);
+	touch_up(1);
+	assert(lg.presses[0] == 1 && lg.releases[0] == 1); /* one click, from the button */
+	teardown();
+
+	/* Two taps in a row: the second is a double click for the terminal. */
+	setup(true);
+	touch_down(1000, 500, 1);
+	touch_up(1);
+	touch_down(1000, 500, 1);
+	touch_up(1);
+	assert(lg.presses[0] == 2 && lg.dbl >= 1);
+	teardown();
+
+	/* Off (the default): no tap at all, and the two finger state keeps its old meaning, a
+	 * middle button press. */
+	setup(false);
+	touch_down(1000, 500, 1);
+	touch_up(1);
+	assert(total(lg.presses) == 0);
+	teardown();
+	setup(false);
+	pointer_dev_button(&dev, BTN_TOOL_DOUBLETAP, 1);
+	assert(lg.presses[1] == 1);
+	teardown();
+
+	/* Only touchpads: a mouse never taps. */
+	setup(true);
+	dev.pointer.kind = POINTER_MOUSE;
+	touch_down(1000, 500, 1);
+	touch_up(1);
+	assert(total(lg.presses) == 0);
+	teardown();
+
+	puts("test_touchpad_tap: ok");
+	return 0;
+}
-- 
2.43.0

