#!/bin/sh
# live-build config for TetronOS. EDITION selects the level (server|desktop);
# FIRMWARE (none|all) is set by scripts/build.sh from the edition default.
set -e
EDITION="${EDITION:-server}"
: "${FIRMWARE:?FIRMWARE must be none or all (set by scripts/build.sh)}"

APPEND="boot=live components username=tetronos hostname=tetron locales=en_US.UTF-8 keyboard-layouts=us"
case "$EDITION" in
	server)  APPEND="$APPEND console=tty0 console=ttyS0,115200n8" ;;
	desktop) APPEND="$APPEND quiet console=ttyS0,115200n8 console=tty0" ;;
	*) echo "unknown EDITION: $EDITION" >&2; exit 1 ;;
esac
case "$FIRMWARE" in
	none) FW=false ;;
	all)  FW=true ;;
	*) echo "unknown FIRMWARE: $FIRMWARE" >&2; exit 1 ;;
esac

lb config noauto \
	--distribution trixie --architectures amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--binary-images iso-hybrid --bootloaders "grub-efi,syslinux" \
	--debian-installer none --firmware-chroot "$FW" --memtest none --backports true \
	--debootstrap-options "--variant=minbase" \
	--apt-indices false --apt-recommends false \
	--iso-application TetronOS --iso-volume "TETRONOS" --iso-publisher TetronOS \
	--bootappend-live "$APPEND" \
	--chroot-squashfs-compression-type xz \
	"${@}"
